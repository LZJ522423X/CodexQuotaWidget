<Window x:Class="CodexQuotaWidget.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CodexQuotaWidget" Title="Codex Quota Widget" Width="440" Height="610" MinWidth="400" MinHeight="420" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Background="{DynamicResource Surface}" FontFamily="Microsoft YaHei UI" Foreground="{DynamicResource Ink}">
<Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="20,16">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel>
<DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource Icon}" Content="&#xE711;" ToolTip="关闭面板" Click="HideClick"/><TextBlock Text="Codex 额度" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
<TextBlock x:Name="StatusText" Margin="0,7,0,0"/>
<TextBlock x:Name="PlanText" Foreground="{DynamicResource Muted}" Margin="0,4,0,12" FontSize="12"/>
<Border Height="1" Background="{DynamicResource Line}"/>
</StackPanel>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,14,8,10">
<StackPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<StackPanel Margin="0,0,8,0"><TextBlock Text="5 小时额度" HorizontalAlignment="Center" FontWeight="SemiBold"/><local:Ring x:Name="FiveRing" Width="142" Height="142" Margin="0,10,0,8" Accent="#21A179"/><TextBlock x:Name="FiveCountdown" TextAlignment="Center"/><TextBlock x:Name="FiveReset" FontSize="11" Foreground="{DynamicResource Muted}" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel>
<StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="每周额度" HorizontalAlignment="Center" FontWeight="SemiBold"/><local:Ring x:Name="WeekRing" Width="142" Height="142" Margin="0,10,0,8" Accent="#3983D4"/><TextBlock x:Name="WeekCountdown" TextAlignment="Center"/><TextBlock x:Name="WeekReset" FontSize="11" Foreground="{DynamicResource Muted}" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel>
</Grid>
<Border Height="1" Background="{DynamicResource Line}" Margin="0,18,0,12"/>
<StackPanel x:Name="ExtraWindows"/>
<TextBlock Text="可用额度重置次数" FontWeight="SemiBold" Margin="0,4,0,5"/>
<TextBlock x:Name="CreditCount" FontSize="23" FontWeight="SemiBold"/>
<TextBlock x:Name="CreditExpiry" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,5,0,8"/>
<TextBlock x:Name="ErrorText" Foreground="#D05B54" FontSize="12"/>
</StackPanel></ScrollViewer>
<StackPanel Grid.Row="2"><Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,10"/>
<DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="RefreshButton" Style="{StaticResource Icon}" Content="&#xE72C;" ToolTip="刷新" Click="RefreshClick" Margin="0,0,6,0"/><Button Style="{StaticResource Icon}" Content="&#xE718;" ToolTip="固定／取消固定窗口" Click="PinClick" Margin="0,0,6,0"/><Button Style="{StaticResource Icon}" Content="&#xE713;" ToolTip="设置" Click="SettingsClick"/></StackPanel><TextBlock x:Name="UpdatedText" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/></DockPanel>
</StackPanel></Grid></Border></Window>
